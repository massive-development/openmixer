{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMixer",
  "identifier": "org.openmixer.app",
  "build": { "frontendDist": "./web/dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "OpenMixer", "width": 1600, "height": 780 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
