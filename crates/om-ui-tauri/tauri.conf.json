{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMixer",
  "identifier": "dev.openmixer.app",
  "build": { "frontendDist": "./web/dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "OpenMixer DJ", "width": 1600, "height": 960 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
