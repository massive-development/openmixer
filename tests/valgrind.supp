# JUCE 8 bundles SheenBidi; its bidi run resolution reads a heap byte it never wrote whenever any
# text is shaped (hit by every UI test that paints a label). Third-party, not our code.
# Usage: valgrind --leak-check=full --error-exitcode=1 --suppressions=tests/valgrind.supp <openmixer_tests>
{
   JUCE_SheenBidi_uninitialised_bidi_chain
   Memcheck:Cond
   fun:BidiChainIsSingle
   ...
}

# libasound keeps its global config cache for the process lifetime; any MIDI/audio device enumeration
# (juce::MidiInput::getAvailableDevices) allocates it. Third-party, reported as "possibly lost".
{
   libasound_config_cache
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   fun:malloc
   ...
   obj:*/libasound.so*
}
{
   libasound_config_cache_calloc
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   fun:calloc
   ...
   obj:*/libasound.so*
}
