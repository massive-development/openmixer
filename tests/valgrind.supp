# JUCE 8 bundles SheenBidi; its bidi run resolution reads a heap byte it never wrote whenever any
# text is shaped (hit by every UI test that paints a label). Third-party, not our code.
# Usage: valgrind --leak-check=full --error-exitcode=1 --suppressions=tests/valgrind.supp <openmixer_tests>
{
   JUCE_SheenBidi_uninitialised_bidi_chain
   Memcheck:Cond
   fun:BidiChainIsSingle
   ...
}
